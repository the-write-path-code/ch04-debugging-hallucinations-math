%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "48px", "primaryTextColor": "#000000", "lineColor": "#4B5563"}}}%%
flowchart TD
    X["Observed Output: 'Answer states: 90 days'"]

    subgraph P1 ["Phase 1: Retrieval & Grounding Triage"]
        direction LR
        C1{"1. Document Retrieved?<br/>[Recall@5, MRR]"} -->|Yes| C2{"2. Text Stated 90 Days?<br/>[Grounding, Faithfulness]"}
        C1 -->|No| R1["Retrieval Failure<br/>• Fix ranking & chunking"]
        C2 -->|No| R2["Grounding Failure<br/>• Enforce [doc#chunk] tokens"]
    end

    subgraph P2 ["Phase 2: Sufficiency & Scope Triage"]
        direction LR
        C3{"3. Current & Sufficient?<br/>[Sufficiency Class]"} -->|Yes| C4{"4. Exact Scope Match?<br/>[Relevancy, Precision]"}
        C3 -->|No| R3["Sufficiency Failure<br/>• Stale policy detected"]
        C4 -->|No| R4["Scope Failure<br/>• Exception bounds"]
        C4 -->|Yes| R5["Grounded & Verified Answer<br/>• Verified citations"]
    end

    X --> P1
    P1 --> P2

    classDef obs fill:#F3F4F6,stroke:#4B5563,color:#000000,stroke-width:1.5px
    classDef check fill:#FEF9C3,stroke:#CA8A04,color:#000000,stroke-width:1.5px
    classDef fail fill:#FEE2E2,stroke:#DC2626,color:#000000,stroke-width:1.5px
    classDef pass fill:#DCFCE7,stroke:#15803D,color:#000000,stroke-width:1.5px

    class X obs
    class C1,C2,C3,C4 check
    class R1,R2,R3,R4 fail
    class R5 pass
