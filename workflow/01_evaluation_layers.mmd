%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "22px", "primaryTextColor": "#000000", "lineColor": "#4B5563"}}}%%
flowchart TD
    Q["<div style='min-width: 940px; text-align: center;'><b>User Question</b></div>"]
    RET["<div style='min-width: 940px; text-align: center;'><b>1. Deterministic Retrieval (BM25 Okapi top-5)</b><br/>Retrieves candidate reference chunks from indexed corpus</div>"]
    GEN["<div style='min-width: 940px; text-align: center;'><b>2. Grounded Generation (LLM with Citations)</b><br/>Synthesizes answer strictly anchored to retrieved citations [doc#chunk]</div>"]

    Q --> RET
    RET -->|"Retrieved Chunks"| GEN

    subgraph EvalStack ["Four-Layer Evaluation Stack"]
        direction LR
        subgraph ColGen ["Generation Verification"]
            direction TB
            L2["<div style='min-width: 440px; text-align: center;'><b>Layer 2: Ragas Metrics</b><br/>Context Precision &bull; Faithfulness</div>"]
            L3["<div style='min-width: 440px; text-align: center;'><b>Layer 3: Claim Grounding Judge</b><br/>Atomic Claims &bull; Grounding Rate</div>"]
            L2 ~~~ L3
        end
        subgraph ColRet ["Retrieval Verification"]
            direction TB
            L1["<div style='min-width: 440px; text-align: center;'><b>Layer 1: Deterministic Metrics</b><br/>Recall@5 &bull; Precision@5 &bull; MRR</div>"]
            L4["<div style='min-width: 440px; text-align: center;'><b>Layer 4: Evidence Sufficiency</b><br/>Sufficient &bull; Partial &bull; Conflicting</div>"]
            L1 ~~~ L4
        end
    end

    RET -->|"Chunks"| L1
    RET -->|"Chunks"| L4
    GEN -->|"Answer"| L2
    GEN -->|"Answer"| L3

    GATE["<div style='min-width: 940px; text-align: center;'><b>Layer 5: Deterministic Policy Gate (Rule Engine &amp; Calibrated Thresholds)</b><br/>Evaluates multi-layer scores against calibrated policy boundaries</div>"]

    L1 --> GATE
    L4 --> GATE
    L2 --> GATE
    L3 --> GATE

    subgraph Outcomes ["Deterministic Decisions"]
        direction LR
        ANS["<div style='min-width: 235px; text-align: center;'><b>ANSWER</b><br/>Verified [doc#chunk]</div>"]
        QUAL["<div style='min-width: 235px; text-align: center;'><b>QUALIFIED_ANSWER</b><br/>Bounded Scope</div>"]
        ABST["<div style='min-width: 235px; text-align: center;'><b>ABSTAIN</b><br/>Safe Refusal</div>"]
        BLOCK["<div style='min-width: 235px; text-align: center;'><b>BLOCK / ESCALATE</b><br/>Human Review Queue</div>"]
    end

    GATE --> ANS
    GATE --> QUAL
    GATE --> ABST
    GATE --> BLOCK

    classDef pipe fill:#EBF5FF,stroke:#2563EB,color:#000000,stroke-width:1.5px
    classDef layer fill:#EDE9FE,stroke:#7C3AED,color:#000000,stroke-width:1.5px
    classDef gate fill:#FEF9C3,stroke:#CA8A04,color:#000000,stroke-width:1.5px
    classDef ans fill:#DCFCE7,stroke:#15803D,color:#000000,stroke-width:1.5px
    classDef warn fill:#FEF3C7,stroke:#D97706,color:#000000,stroke-width:1.5px
    classDef block fill:#FEE2E2,stroke:#DC2626,color:#000000,stroke-width:1.5px

    class Q,RET,GEN pipe
    class L1,L4,L2,L3 layer
    class GATE gate
    class ANS ans
    class QUAL,ABST warn
    class BLOCK block
