# Copy this file to .env and add real values locally.
# Do not commit .env.

# Ollama Cloud
OLLAMA_API_KEY=
# Confirm the endpoint and selected model names from your existing Ollama Cloud setup.
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=
OLLAMA_JUDGE_MODEL=

# Opik Cloud
OPIK_API_KEY=
# Leave blank unless your Opik configuration requires an explicit endpoint override.
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=ch04-debugging-hallucinations-math
OPIK_WORKSPACE=
OPIK_ENABLED=true

# Optional: only required if the chosen embedding or reranking model is gated.
HF_TOKEN=

# Application settings
LOG_LEVEL=INFO
