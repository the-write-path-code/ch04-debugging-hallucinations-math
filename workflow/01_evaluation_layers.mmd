%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "72px", "primaryTextColor": "#000000", "lineColor": "#4B5563"}}}%%
flowchart TD
    Q["User Question"] --> RET["1. Deterministic Retrieval (BM25 Okapi top-5)"]
    RET -->|Retrieved Chunks| GEN["2. Grounded Generation (LLM with Citations)"]

    subgraph EvalStack ["Four-Layer Evaluation Stack"]
        direction LR
        L1["Layer 1: Deterministic Metrics<br/>Recall@5, Precision@5, MRR"]
        L4["Layer 4: Evidence Sufficiency<br/>Sufficient, Partial, Conflicting"]
        L2["Layer 2: Ragas Metrics<br/>Context Precision, Faithfulness"]
        L3["Layer 3: Claim Grounding Judge<br/>Atomic Claims & Grounding Rate"]
    end

    GATE["Layer 5: Deterministic Policy Gate (Rule Engine & Calibrated Thresholds)"]

    subgraph Outcomes ["Deterministic Decisions"]
        direction LR
        ANS["ANSWER<br/>Verified [doc#chunk]"]
        QUAL["QUALIFIED_ANSWER<br/>Bounded Scope"]
        ABST["ABSTAIN<br/>Safe Refusal"]
        BLOCK["BLOCK / ESCALATE<br/>Human Review Queue"]
    end

    RET -->|Chunks| L1
    RET -->|Chunks| L4
    GEN -->|Answer| L2
    GEN -->|Answer| L3

    L1 --> GATE
    L4 --> GATE
    L2 --> GATE
    L3 --> GATE

    GATE --> ANS
    GATE --> QUAL
    GATE --> ABST
    GATE --> BLOCK

    classDef pipe fill:#EBF5FF,stroke:#2563EB,color:#000000,stroke-width:1.5px
    classDef layer fill:#EDE9FE,stroke:#7C3AED,color:#000000,stroke-width:1.5px
    classDef gate fill:#FEF9C3,stroke:#CA8A04,color:#000000,stroke-width:1.5px
    classDef ans fill:#DCFCE7,stroke:#15803D,color:#000000,stroke-width:1.5px
    classDef warn fill:#FEF3C7,stroke:#D97706,color:#000000,stroke-width:1.5px
    classDef block fill:#FEE2E2,stroke:#DC2626,color:#000000,stroke-width:1.5px

    class Q,RET,GEN pipe
    class L1,L4,L2,L3 layer
    class GATE gate
    class ANS ans
    class QUAL,ABST warn
    class BLOCK block
